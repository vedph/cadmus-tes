{
  "context": {
    "id": "it.vedph.entry-set-context.cadmus"
  },
  "entryReader": {
    "id": "entry-reader.xlsx",
    "options": {
      "inputFile": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\tes.xlsx",
      "hasHeaderRow": true,
      "columnNameFiltering": true,
      "eofCheckColumn": 1,
      "lastSheetIndex": 0
    }
  },
  "entrySetBoundaryDetector": {
    "id": "entry-set-detector.cmd",
    "options": {
      "type": 2,
      "name": "row-end"
    }
  },
  "entryRegionDetectors": [
    {
      "id": "region-detector.explicit",
      "options": {
        "unpairedCommandNames": [
          "sheet",
          "row",
          "col"
        ],
        "tagSuffixArgName": "n",
        "tagSuffixSeparator": "-"
      }
    },
    {
      "id": "region-detector.unmapped",
      "options": {
        "unmappedRegionTag": "x"
      }
    }
  ],
  "entryRegionParsers": [
    {
      "id": "entry-region-parser.tes.row-inscription"
    },
    {
      "id": "entry-region-parser.tes.col-metadata",
      "options": {
        "tag": "col-id",
        "name": "eid",
        "setTitle": true,
        "isRequired": true,
        "reuseIdsFrom": "item-ids-i"
      }
    },
    {
      "id": "entry-region-parser.tes.col-date"
    },
    {
      "id": "entry-region-parser.tes.col-place-links"
    },
    {
      "id": "entry-region-parser.tes.col-ins-coords"
    },
    {
      "id": "entry-region-parser.tes.col-support"
    },
    {
      "id": "entry-region-parser.tes.col-categories",
      "options": {
        "tag": "col-type",
        "thesaurusId": "categories_ins-fn@en",
        "partRoleId": "ins-fn",
        "allowMultipleValues": true,
        "separator": "|"
      }
    },
    {
      "id": "entry-region-parser.tes.col-technique"
    },
    {
      "id": "entry-region-parser.tes.col-categories",
      "options": {
        "tag": "col-language",
        "thesaurusId": "categories_ins-lng@en",
        "partRoleId": "ins-lng",
        "allowMultipleValues": true,
        "separator": "|",
        "isRequired": true
      }
    },
    {
      "id": "entry-region-parser.tes.col-metadata",
      "options": {
        "tag": "col-repository_name",
        "name": "preservation-place"
      }
    },
    {
      "id": "entry-region-parser.tes.col-metadata",
      "options": {
        "tag": "col-inventory_number",
        "name": "inventory-nr"
      }
    },
    {
      "id": "entry-region-parser.tes.col-text"
    }
  ],
  "entrySetContextPatchers": [
    {
      "id": "it.vedph.entry-set-context-patcher.cadmus"
    }
  ],
  "entrySetExporters": [
    {
      "id": "entry-set-exporter.excel-dump",
      "options": {
        "maxEntriesPerDumpFile": 10000,
        "outputDirectory": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\tes-dump"
      }
    }
  ]
}
