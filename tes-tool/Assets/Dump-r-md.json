{
  "context": {
    "id": "it.vedph.entry-set-context.cadmus"
  },
  "entryReader": {
    "id": "entry-reader.xlsx",
    "options": {
      "inputFile": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\tes-sites.xlsx",
      "hasHeaderRow": true,
      "columnNameFiltering": true,
      "eofCheckColumn": 2
    }
  },
  "entrySetBoundaryDetector": {
    "id": "entry-set-detector.cmd",
    "options": {
      "type": 2,
      "name": "row-end"
    }
  },
  "entryRegionDetectors": [
    {
      "id": "region-detector.explicit",
      "options": {
        "unpairedCommandNames": [
          "sheet",
          "row",
          "col"
        ],
        "tagSuffixArgName": "n",
        "tagSuffixSeparator": "-"
      }
    },
    {
      "id": "region-detector.unmapped",
      "options": {
        "unmappedRegionTag": "x"
      }
    }
  ],
  "entryRegionParsers": [
    {
      "id": "entry-region-parser.tes.row-resource",
      "options": {
        "partRoleId": "site-res"
      }
    },
    {
      "id": "entry-region-parser.tes.col-parent-item-id",
      "options": {
        "tag": "col-site_id"
      }
    },
    {
      "id": "entry-region-parser.tes.col-res-data-accuracy",
      "options": {
        "tag": "col-res_data_accuracy",
        "thesaurusId": "site-resource-tags_site-res"
      }
    },
    {
      "id": "entry-region-parser.tes.col-resource-type",
      "options": {
        "tag": "col-resource_type",
        "thesaurusId": "site-resource-types_site-res"
      }
    },
    {
      "id": "entry-region-parser.tes.col-resource-feature-id",
      "options": {
        "tag": "col-resource_feature_id",
        "thesaurusId": "site-resource-features_site-res"
      }
    },
    {
      "id": "entry-region-parser.tes.col-coords"
    }
  ],
  "entrySetContextPatchers": [
    {
      "id": "it.vedph.entry-set-context-patcher.cadmus"
    }
  ],
  "entrySetExporters": [
    {
      "id": "it.vedph.entry-set-exporter.cadmus.md-dump",
      "options": {
        "outputDirectory": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\tes-dump\\",
        "noEntries": true,
        "jsonParts": true
      }
    },
    {
      "id": "it.vedph.entry-set-exporter.cadmus.item-id",
      "options": {
        "outputPath": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\tes-dump\\item-ids.json"
      }
    }
  ]
}
