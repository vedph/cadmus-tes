{
  "context": {
    "id": "it.vedph.entry-set-context.cadmus"
  },
  "entryReader": {
    "id": "entry-reader.xlsx",
    "options": {
      "inputFile": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\tes-sites.xlsx",
      "hasHeaderRow": true,
      "columnNameFiltering": true,
      "eofCheckColumn": 2,
      "lastSheetIndex": 0
    }
  },
  "entrySetBoundaryDetector": {
    "id": "entry-set-detector.cmd",
    "options": {
      "type": 2,
      "name": "row-end"
    }
  },
  "entryRegionDetectors": [
    {
      "id": "region-detector.explicit",
      "options": {
        "unpairedCommandNames": [
          "sheet",
          "row",
          "col"
        ],
        "tagSuffixArgName": "n",
        "tagSuffixSeparator": "-"
      }
    },
    {
      "id": "region-detector.unmapped",
      "options": {
        "unmappedRegionTag": "x"
      }
    }
  ],
  "entryRegionParsers": [
    {
      "id": "entry-region-parser.tes.row-site"
    },
    {
      "id": "it.vedph.entry-region-parser.xlsx.col-metadata",
      "options": {
        "tag": "col-site_id",
        "name": "eid",
        "isRequired": true,
        "reuseIdsFrom": "item-ids-s"
      }
    },
    {
      "id": "entry-region-parser.tes.col-site-name"
    },
    {
      "id": "it.vedph.entry-region-parser.xlsx.col-categories",
      "options": {
        "tag": "col-archaeological_site_type",
        "thesaurusId": "categories_site-type@en",
        "partRoleId": "site-type"
      }
    },
    {
      "id": "it.vedph.entry-region-parser.xlsx.col-categories",
      "options": {
        "tag": "col-data_accuracy",
        "thesaurusId": "categories_evidence@en",
        "partRoleId": "evidence"
      }
    },
    {
      "id": "entry-region-parser.tes.col-coords"
    },
    {
      "id": "entry-region-parser.tes.col-site-pleiades"
    },
    {
      "id": "entry-region-parser.tes.col-site-geonames"
    },
    {
      "id": "it.vedph.entry-region-parser.xlsx.col-flags",
      "options": {
        "thesaurusId": "categories_site-feats@en",
        "partRoleId": "site-feats",
        "flags": {
          "col-cults": "cults",
          "col-resources": "resources",
          "col-storage": "storage",
          "col-production": "production",
          "col-status_marker": "status-marker",
          "col-figurative_representations": "representations-figurative",
          "col-inscriptions": "inscriptions"
        }
      }
    },
    {
      "id": "it.vedph.entry-region-parser.xlsx.col-periods"
    },
    {
      "id": "it.vedph.entry-region-parser.xlsx.col-note",
      "options": {
        "tag": "col-evidence_note",
        "partRoleId": "evidence"
      }
    },
    {
      "id": "it.vedph.entry-region-parser.xlsx.col-note",
      "options": {
        "tag": "col-certainty_note",
        "partRoleId": "certainty"
      }
    }
  ],
  "entrySetContextPatchers": [
    {
      "id": "it.vedph.entry-set-context-patcher.cadmus"
    }
  ],
  "entrySetExporters": [
    {
      "id": "it.vedph.entry-set-exporter.cadmus.md-dump",
      "options": {
        "outputDirectory": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\tes-dump-s\\",
        "noEntries": true,
        "jsonParts": true
      }
    },
    {
      "id": "it.vedph.entry-set-exporter.cadmus.item-id",
      "options": {
        "outputPath": "{{HOMEDRIVE}}{{HOMEPATH}}\\Desktop\\tes\\item-ids-s.json"
      }
    }
  ]
}
